# Fresh HypeGraph backend environment. Copy to .env.server; it remains gitignored.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Dedicated HypeGraph Solana provider. Never expose these values in VITE_*.
SOLANA_RPC_URL=
SOLANA_WS_URL=
PUMP_COMMITMENT=confirmed
PUMP_BACKFILL_MAX_PAGES=1
PUMP_BACKFILL_PAGE_SIZE=100
PUMP_BACKFILL_BATCH_SIZE=1
PUMP_BACKFILL_REQUEST_DELAY_MS=350

# Optional production adapters
POSTGRES_URL=
REDIS_URL=
CLICKHOUSE_URL=
GRAPH_DATABASE_URL=
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
WEBHOOK_SIGNING_SECRET=
AUTH_JWT_SECRET=
