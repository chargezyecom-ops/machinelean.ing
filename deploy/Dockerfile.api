FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY server ./server
COPY src/services/pumpEventDecoder.js ./src/services/pumpEventDecoder.js
COPY src/data/terminalFeatures.js ./src/data/terminalFeatures.js
COPY src/data/marketSnapshot.js ./src/data/marketSnapshot.js
EXPOSE 8787
CMD ["npm", "run", "start:api"]
