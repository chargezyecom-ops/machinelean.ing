# HypeGraph frontend. Every VITE_* value is public and bundled in the browser.
# Never expose Helius, X, database or model-provider secrets here.

VITE_APP_MODE=snapshot
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_TERMINAL_URL=/app
VITE_API_BASE_URL=http://localhost:8787/api
VITE_RESEARCH_API_ENABLED=false
VITE_SNAPSHOT_ID=2026-08-25T08:30:00Z

# Public/read-only runtime configuration
VITE_SOLANA_NETWORK=mainnet-beta
VITE_EXPLORER_BASE_URL=https://solscan.io
VITE_GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
VITE_DEXSCREENER_BASE_URL=https://api.dexscreener.com
VITE_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
VITE_PUMP_COMMITMENT=confirmed

# Optional public product integrations
VITE_ANALYTICS_ENDPOINT=
VITE_SENTRY_DSN=
VITE_CONTACT_EMAIL=

# SERVER-ONLY variables to add in the future API service — never prefix with VITE_:
# HELIUS_API_KEY=
# SOLANA_RPC_URL=
# SOLANA_WS_URL=
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# GRAPH_DATABASE_URL=
# GRAPH_DATABASE_USER=
# GRAPH_DATABASE_PASSWORD=
# PUMP_BACKFILL_MAX_PAGES=1
# PUMP_BACKFILL_PAGE_SIZE=100
# PUMP_BACKFILL_BATCH_SIZE=5
# PUMP_BACKFILL_REQUEST_DELAY_MS=350
# PUMP_BACKFILL_BEFORE=
# X_BEARER_TOKEN=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# POSTGRES_URL=
# REDIS_URL=
# MODEL_GATEWAY_KEY=
# MODEL_GATEWAY_URL=
# WEBHOOK_SIGNING_SECRET=
# AUTH_JWT_SECRET=
# SENTRY_DSN=
